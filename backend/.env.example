NODE_ENV=development
PORT=3000
# Local worker health server. Do not set this to PORT — the API already binds there.
WORKER_PORT=4000

# Queue / Key Value (Render Key Value internal URL in production)
REDIS_URL=redis://localhost:6379

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Gemini powers both survey AI and semantic action search.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDINGS_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
ACTION_EMBEDDING_VERSION=gemini-embedding-001-768-l2-v1
ACTION_SEARCH_MIN_SIMILARITY=0.70
ACTION_SEARCH_MAX_RESULTS=50
ACTION_EMBEDDING_TIMEOUT_MS=10000

# Optional connector defaults
GITHUB_TOKEN=your-github-token
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_TOKEN=your-jira-token

# Survey feature: broadcast channels - a bot posts the shared link ONCE to a
# team channel/server/group rather than DMing every recipient individually.
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=your-slack-channel-id
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-group-or-channel-chat-id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Survey feature: AI question quality gate. Questions scoring below MIN on the
# holistic "overall" dimension are dropped; at most MAX_COUNT are returned.
SURVEY_QUESTION_MIN_SCORE=60
SURVEY_QUESTION_MAX_COUNT=6

# Survey feature: one shared monthly auto-pulse per project. Each project gets
# its own randomized send moment inside the window. Questions generate LEAD_DAYS before
# that moment. Managers can edit or pause during the review window; otherwise
# the survey auto-sends at the assigned moment.
SURVEY_MONTHLY_START_DAY=1
SURVEY_MONTHLY_WINDOW_DAYS=3
SURVEY_QUESTION_GEN_LEAD_DAYS=2

# Survey feature: how many days a survey link stays open for responses before it
# expires. Customizable, clamped to a 7-15 day range.
SURVEY_RESPONSE_DEADLINE_DAYS=7

# Minimum anonymous submissions required before Gemini analysis and raw-text
# result visibility. Values below 3 are clamped to 3.
SURVEY_MIN_ANONYMOUS_RESPONSES=5

# Survey feature: encrypted link tokens - 32 random bytes, base64url-encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SURVEY_TOKEN_ENC_KEY=your-32-byte-base64url-key

# Survey feature: "Send Survey Now" cap per project per calendar month
MANUAL_SURVEY_MONTHLY_LIMIT=2

# Survey feature: base URL the frontend serves the anonymous survey form at (token gets appended)
SURVEY_FORM_BASE_URL=http://localhost:5173/survey
