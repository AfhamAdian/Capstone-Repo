NODE_ENV=development
PORT=3000

# Queue / Key Value (Render Key Value internal URL in production)
REDIS_URL=redis://localhost:6379

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Optional connector defaults
GITHUB_TOKEN=your-github-token
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_TOKEN=your-jira-token

# Survey feature: AI question generation/analysis (Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Survey feature: link delivery (per-recipient channels: email, Slack DM, Discord DM)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=surveys@your-domain.com
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# Discord bot: DMs recipients with a User.discord_user_id on file (no email-based lookup exists,
# unlike Slack - that column must be populated out of band). Needs the DIRECT_MESSAGES intent
# and the "Send Messages" permission in whatever server the bot shares with your team.
DISCORD_BOT_TOKEN=your-discord-bot-token

# Survey feature: broadcast channels (shared-link mode posts one link to a team group/channel)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-group-or-channel-chat-id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Survey feature: link distribution model.
#   shared      = ONE anonymous link per survey cycle, reusable by the whole cohort (default).
#   single_use  = one per-developer link, atomically consumed on first submit.
# Flip this single value to switch strategies - no code change needed.
SURVEY_LINK_MODE=shared

# Survey feature: AI question quality gate. Questions scoring below MIN on the
# holistic "overall" dimension are dropped; at most MAX_COUNT are returned.
SURVEY_QUESTION_MIN_SCORE=60
SURVEY_QUESTION_MAX_COUNT=6

# Survey feature: two-round monthly auto-pulse scheduling. Round 1 opens on
# ROUND1_START_DAY, round 2 on ROUND2_START_DAY; each project gets its own
# randomized send moment somewhere inside that round's WINDOW_DAYS-day window
# (so projects don't all fire at once). Questions generate LEAD_DAYS before
# that moment - editable by level-1 users, no approval gate, auto-sends at
# the assigned moment.
SURVEY_ROUND1_START_DAY=1
SURVEY_ROUND2_START_DAY=15
SURVEY_ROUND_WINDOW_DAYS=3
SURVEY_QUESTION_GEN_LEAD_DAYS=2

# Survey feature: minimum number of days that must pass before the same developer
# can be auto-pulse surveyed again (also excluded outright within the same calendar month).
SURVEY_MIN_DAYS_BETWEEN_SURVEYS=15

# Survey feature: encrypted link tokens - 32 random bytes, base64url-encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SURVEY_TOKEN_ENC_KEY=your-32-byte-base64url-key

# Survey feature: "Send Survey Now" cap per project per calendar month
MANUAL_SURVEY_MONTHLY_LIMIT=2

# Survey feature: base URL the frontend serves the anonymous survey form at (token gets appended)
SURVEY_FORM_BASE_URL=http://localhost:5173/survey
