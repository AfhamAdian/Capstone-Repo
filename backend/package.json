{
  "name": "backend",
  "version": "1.0.0",
  "description": "Node.js Express MVC backend",
  "private": true,
  "type": "module",
  "main": "dist/apps/api/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch apps/api/server.ts",
    "dev:worker": "tsx watch apps/worker/worker.ts",
    "build": "tsc -p tsconfig.json",
    "postbuild": "tsc-alias -p tsconfig.json",
    "start": "node dist/apps/api/server.js",
    "start:worker": "node dist/apps/worker/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:actions": "node --import tsx --test tests/action-search.test.ts tests/embeddings.test.ts tests/pinecone-reranker.test.ts",
    "backfill:action-embeddings": "tsx scripts/backfill-action-embeddings.ts",
    "test:github-metrics": "npm run build && node dist/scripts/test-github-metrics.js",
    "test:jira-metrics": "npm run build && node dist/scripts/test-jira-metrics.js"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@octokit/plugin-retry": "^6.1.0",
    "@octokit/plugin-throttling": "^8.2.0",
    "@octokit/rest": "^20.1.0",
    "@slack/web-api": "^8.0.0",
    "@supabase/supabase-js": "^2.101.1",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "fast-xml-parser": "^5.11.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "resend": "^6.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.10"
  }
}
